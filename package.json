{
  "name": "rag-guardrails",
  "version": "0.1.0",
  "description": "Dependency-free guardrails for RAG and LLM apps: grounding checks, prompt-injection detection and secret redaction",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/src"],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "example": "tsc && node dist/examples/support-bot.js"
  },
  "keywords": ["rag", "llm", "guardrails", "prompt-injection", "hallucination", "ai-safety", "typescript"],
  "author": "Umar Javed",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
